{
  "firestore": {
    "database": "default",
    "location": "europe-west1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist/clockedin/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.csr.html" }]
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
