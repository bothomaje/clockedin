rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User's own top-level doc (profile, career, etc.)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // User's job applications
    match /users/{userId}/jobs/{jobId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User's generated cv and cover letter docs
    match /users/{userId}/jobs/{jobId}/generatedDocuments/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{uid}/meta/aiUsage {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }
  }
}