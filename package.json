{
  "name": "clockedin",
  "version": "0.0.0",
  "scripts": {
    "env:development": "node --env-file=.env.development scripts/generate-environment.mjs development",
    "env:staging": "node --env-file=.env.staging scripts/generate-environment.mjs staging",
    "env:production": "node --env-file=.env.production scripts/generate-environment.mjs production",
    "ng": "ng",
    "start": "npm run env:development && ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:staging": "npm run env:staging && ng build --configuration staging",
    "build:production": "npm run env:production && ng build --configuration production",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^28.0.0",
    "prettier": "3.9.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
